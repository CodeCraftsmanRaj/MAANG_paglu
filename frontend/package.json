{
  "name": "contextforge-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "author": { "name": "ContextForge Team", "email": "team@contextforge.dev" },
  "homepage": "http://contextforge-ui-271740378665.s3-website.us-east-1.amazonaws.com",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop": "electron .",
    "dist": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.contextforge.ui",
    "productName": "ContextForge",
    "files": [
      "electron/**",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Utility"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": ["nsis"]
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.0"
  },
  "overrides": {
    "@noble/hashes": "1.3.1"
  }
}