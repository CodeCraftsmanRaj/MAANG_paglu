{
  "name": "contextforge-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "author": { "name": "ContextForge Team", "email": "team@contextforge.dev" },
  "homepage": "http://contextforge-ui-271740378665.s3-website.us-east-1.amazonaws.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeCraftsmanRaj/MAANG_paglu"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop": "electron .",
    "dist": "vite build && electron-builder --linux --publish never",
    "dist:linux": "vite build && electron-builder --linux --publish never",
    "dist:mac": "vite build && electron-builder --mac --publish never",
    "dist:win": "vite build && electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.contextforge.ui",
    "productName": "ContextForge",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Utility"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": ["nsis"]
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.0"
  }
}
