# Copy to .env.production (or set inline) to point the UI at a deployed backend.
# Leave unset for local development — the vite dev proxy handles /api -> 127.0.0.1:8000.
#
# Example (API Gateway URL from the deploy output):
# VITE_API_URL=https://abcd1234.execute-api.us-east-1.amazonaws.com
#
# Build the web app with:
#   VITE_API_URL=https://abcd1234.execute-api.us-east-1.amazonaws.com npm run build
#
# Electron tip: point the desktop shell at any hosted UI with
#   APP_URL=https://<your-hosted-ui> npm run desktop
