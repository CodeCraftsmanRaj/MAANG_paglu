# ==============================================================================
# ContextForge Configuration Example
# Copy this file to .env or .env.local and populate with your API credentials.
# ==============================================================================

# Primary Provider Selection
LLM_PROVIDER=gemini              # options: gemini | groq | bedrock | heuristic
EMBEDDING_PROVIDER=gemini        # options: gemini | fastembed | bedrock | hashed
DB_PROVIDER=sqlite               # options: sqlite | dynamodb

# ------------------------------------------------------------------------------
# Google Gemini Configuration (https://aistudio.google.com)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=                  # AI Studio API key
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768             # Allowed: 768 / 1536 / 3072 (L2 normalized)
GEMINI_LLM_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Groq Cloud Configuration (https://console.groq.com/keys)
# ------------------------------------------------------------------------------
GROQ_API_KEY=                    # gsk_...
GROQ_MODEL=qwen/qwen3.8-27b      # options: qwen/qwen3.8-27b | openai/gpt-oss-120b | groq/compound
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ------------------------------------------------------------------------------
# AWS Bedrock & DynamoDB Configuration (Optional Enterprise Cloud)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1 # 1536 dimensions
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
DYNAMODB_TABLE=contextforge      # DynamoDB single-table name (when DB_PROVIDER=dynamodb)

# ------------------------------------------------------------------------------
# Storage & Local Ingestion
# ------------------------------------------------------------------------------
CF_DB=contextforge2.db           # SQLite database filename
WATCH_DIR=                       # Optional: directory to poll for auto-ingestion (.md, .txt, .json)
