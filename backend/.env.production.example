# ==============================================================================
# ContextForge AWS Production Environment Example
# Copy this file to .env.production (or configure in AWS Secrets Manager / ECS)
# ==============================================================================

# AWS Cloud Production Settings
LLM_PROVIDER=bedrock             # options: bedrock | gemini | groq
EMBEDDING_PROVIDER=bedrock       # options: bedrock | gemini | fastembed
DB_PROVIDER=dynamodb             # options: dynamodb | sqlite

# AWS Region & IAM Credentials (omit keys if using ECS Task Execution Roles)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AWS Bedrock Settings
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1
EMBEDDING_DIM=1536

# AWS DynamoDB Settings
DYNAMODB_TABLE_NAME=contextforge

# Optional Gemini / Groq Cloud Backups
GEMINI_API_KEY=
GROQ_API_KEY=
