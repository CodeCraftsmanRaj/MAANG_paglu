# ==============================================================================
# ContextForge Local Development Environment Example
# Copy this file to .env.local (or .env) and set your API keys.
# ==============================================================================

# Provider Settings
LLM_PROVIDER=gemini              # options: gemini | groq | bedrock | heuristic
EMBEDDING_PROVIDER=gemini        # options: gemini | fastembed | bedrock | hashed
DB_PROVIDER=sqlite               # options: sqlite | dynamodb

# Groq Settings (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Gemini Settings (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768             # allowed: 768 / 1536 / 3072
GEMINI_LLM_MODEL=gemini-2.5-flash

# SQLite Local Database
CF_DB=contextforge2.db

# Optional: Directory poller
WATCH_DIR=
